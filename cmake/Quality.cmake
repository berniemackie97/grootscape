function(grootscape_quality target)
 target_compile_features(${target} PUBLIC cxx_std_23)
 set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF)
 if(MSVC)
  target_compile_options(${target} PRIVATE /W4 /WX /permissive- /EHsc)
 else()
  target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Werror)
  if(GROOTSCAPE_SANITIZER)
   target_compile_options(${target} PRIVATE -fsanitize=${GROOTSCAPE_SANITIZER} -fno-omit-frame-pointer)
   target_link_options(${target} PUBLIC -fsanitize=${GROOTSCAPE_SANITIZER})
  endif()
 endif()
 if(GROOTSCAPE_TIDY)
  find_program(CLANG_TIDY clang-tidy REQUIRED)
  set_target_properties(${target} PROPERTIES CXX_CLANG_TIDY "${CLANG_TIDY};--warnings-as-errors=*")
 endif()
endfunction()
